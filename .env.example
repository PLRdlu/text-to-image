# 复制为 .env 后按需修改；.env 已被 .gitignore 忽略
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# 出图后端：wanx（真实调用）| mock（离线占位图，不花钱）
IMAGE_BACKEND=wanx
IMAGE_MODEL=wan2.6-t2i
IMAGE_SIZE=1024*1024
IMAGE_COUNT=1

# DeepSeek：提示词改写 + 图片质检（deepseek-flash 支持图片输入）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
ENABLE_PROMPT_REWRITE=false
ENABLE_IMAGE_REVIEW=false
REVIEW_THRESHOLD=60

T2I_OUTPUT_DIR=output
LOG_LEVEL=INFO
